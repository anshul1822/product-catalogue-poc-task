# Copy to .env for local overrides. Safe local defaults only; never put real secrets here.
# Every key below has the same default in server/src/config.ts, so .env is optional.
#
# The defaults run the API without Docker: enquiries are kept in memory and emails
# are printed to the console. Docker Compose ignores those three settings and always
# uses PostgreSQL and Mailpit (see docker-compose.yml).

# API server (the port inside the server process / container)
PORT=3000

# Product data comes from the Fake Store API only (single source of truth)
FAKESTORE_BASE_URL=https://fakestoreapi.com
UPSTREAM_TIMEOUT_MS=5000

# The 5 products chosen as "top rated" (home page), in display order
FEATURED_PRODUCT_IDS=12,11,3,18,5

# Enquiries (F5): "memory" (local only, lost on restart) or "postgres" (needs DATABASE_URL)
ENQUIRY_STORE=memory
DATABASE_URL=

# Email (F5): "console" (local only, prints the email) or "smtp"
EMAIL_PROVIDER=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Only for a real provider (for example Amazon SES); leave empty for Mailpit. Never commit real values.
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@catalogue.local
# The sales inbox every enquiry is sent to
SALES_INBOX_EMAIL=sales@catalogue.local
# Base URL of the web app, for the product link in the email
PUBLIC_APP_URL=http://localhost:8080

# Docker Compose: ports on your machine (change them if one is already in use)
APP_PORT=8080
API_PORT=3000
MAILPIT_PORT=8025
POSTGRES_PORT=55432
