# Copy to .env for local overrides. Safe local defaults only; never put real secrets here.
# Every key below has the same default in server/src/config.ts and docker-compose.yml,
# so .env is optional. Slice F5 adds email and enquiry database keys.

# API server (the port inside the server process / container)
PORT=3000

# Product data comes from the Fake Store API only (single source of truth)
FAKESTORE_BASE_URL=https://fakestoreapi.com
UPSTREAM_TIMEOUT_MS=5000

# The 5 products chosen as "top rated" (home page), in display order
FEATURED_PRODUCT_IDS=12,11,3,18,5

# Docker Compose: ports on your machine (change them if 8080 or 3000 is already in use)
APP_PORT=8080
API_PORT=3000
