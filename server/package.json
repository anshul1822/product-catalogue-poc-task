{
  "name": "catalogue-server",
  "version": "0.1.0",
  "private": true,
  "description": "Product catalogue PoC backend",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "snapshot": "npm run build && node dist/scripts/snapshot-catalogue.js"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
