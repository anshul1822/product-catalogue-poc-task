{
  "name": "catalogue-server",
  "version": "0.1.0",
  "private": true,
  "description": "Product catalogue PoC backend",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "start": "node --env-file-if-exists=../.env dist/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "snapshot": "npm run build && node dist/scripts/snapshot-catalogue.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
